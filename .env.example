# ============================================================
#  TEBEX — Headless API
# ============================================================
# Token público de tu tienda (Creator Panel > Developers > API Keys).
# Sin este valor la web arranca en MODO DEMO con un catálogo de ejemplo.
TEBEX_PUBLIC_TOKEN=1398r-d327579726a1ba8a97c470b34d031137c10f5be9


# Token público para el navegador. Se usa solo para crear el carrito desde el
# cliente y que Tebex reciba la IP real del comprador. No es una clave secreta.
# Puedes usar el mismo valor que TEBEX_PUBLIC_TOKEN.
NEXT_PUBLIC_TEBEX_PUBLIC_TOKEN=1398r-d327579726a1ba8a97c470b34d031137c10f5be9


# Opcional. Solo se usa en el servidor para endpoints autenticados.
# NUNCA lo pongas en variables NEXT_PUBLIC_* ni lo subas al repositorio.
TEBEX_PRIVATE_KEY=VeifGZV902pHw9Fd0Mh6eVsmzfprLTy2

